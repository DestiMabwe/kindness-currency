NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Comma-separated emails allowed to view /admin
ADMIN_EMAILS=you@example.com
# Reminder-email cron (see /api/cron/send-reminders)
RESEND_API_KEY=your-resend-api-key-here
REMINDER_FROM_EMAIL=reminders@example.com
CRON_SECRET=a-long-random-secret
# Paystack billing (see src/lib/paystack/client.ts + /api/webhooks/paystack) — same key verifies
# webhook signatures, no separate webhook secret. Test-mode keys work without business verification.
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key-here
